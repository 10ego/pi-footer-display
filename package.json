{
  "name": "pi-footer-display",
  "version": "0.1.0",
  "description": "Add Git repository, branch, pull request, and session age context to Pi's native footer.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "ARCHITECTURE.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js && rm -rf .test-dist"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "footer",
    "git",
    "github",
    "pull-request",
    "status"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
